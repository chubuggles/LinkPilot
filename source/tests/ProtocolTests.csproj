<Project Sdk="Microsoft.NET.Sdk">
  <!-- Hardware-free tests. From this folder: `dotnet run -c Release` (it reads vectors.txt from here). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ProtocolTests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="ProtocolTests.cs" />
    <Compile Include="..\src\Hid\*.cs;..\src\Link\*.cs;..\src\Core\*.cs" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
</Project>
